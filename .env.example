# Edwin (EDWIN_* preferred; DEXDA_* aliases kept for compatibility)
EDWIN_ORG=your_portal_prefix
EDWIN_ID=
EDWIN_TOKEN=
# DEXDA_ORG=your_portal_prefix
# DEXDA_ID=
# DEXDA_TOKEN=

# Elasticsearch
# Use a hostname reachable FROM where the poller runs (not localhost when using docker run).
ELASTIC_URL=https://your-es-host:9200
# Index, comma-separated list, or wildcard pattern (legacy "S" suffix kept for compatibility)
ELASTIC_INDEXS=.kibana-event-log-ds
ELASTIC_BATCH_SIZE=500
ELASTIC_USER=
ELASTIC_PASS=
ELASTIC_TOKEN=

# Optional: Lucene query_string filter applied in addition to the bookmark range.
# Default: * (all documents in the index)
# Recommended for correlation: exclude scheduler noise
# Do not wrap values in quotes — docker --env-file passes quotes literally.
# ELASTIC_QUERY=NOT event.action:execute-start

# Verify TLS certificates for all outbound HTTPS (Elasticsearch, Edwin, LM Logs).
# Default: true. Set false only for controlled test environments.
VERIFY_SSL=true
# Deprecated aliases (used only when VERIFY_SSL is unset):
# ELASTIC_VERIFY_SSL=true
# EDWIN_VERIFY_SSL=true

# Point-in-time lease held for each poll cycle's paginated search (default: 5m).
# Extended on every page, so it only needs to cover the gap between two pages.
ELASTIC_PIT_KEEP_ALIVE=5m
# Re-read this much history to handle delayed/out-of-order events.
# Delivered documents are deduplicated locally.
ELASTIC_OVERLAP_MS=300000
# Hard safety limits for the local deduplication SQLite database.
DEDUPE_MAX_RECORDS=250000
DEDUPE_MAX_SIZE_MB=256

# Poller
POLLER_INTERVAL=240
BOOKMARK_PATH=./data
DEBUG=false
LOG=true

# Optional: ship operational logs to LogicMonitor LM Logs for monitoring.
# Create a bearer token under Settings > Users & Roles with Logs Manage permission.
# LM_LOGS_ENABLED=false
# LM_LOGS_ACCOUNT=your_portal_prefix
# LM_LOGS_BEARER_TOKEN=
# LM_LOGS_RESOURCE_ID=42
# LM_LOGS_VERBOSE=false

# Optional directory for rejected Edwin payloads. Disabled by default.
# FAILED_PAYLOAD_PATH=./failed-payloads

# Optional path to a custom CEF mapping YAML (overrides the bundled default).
# EVENT_MAPPING_FILE=./elastic_event_mappings.yaml
